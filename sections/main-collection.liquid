{%- comment -%} One product, two collections of colours: collection and search pages show the two blankets. {%- endcomment -%}
<section class="container-soft pb-24 pt-8 sm:pt-14">
  <h1 class="font-serif text-[3rem] font-light leading-[0.95] tracking-[-0.045em] sm:text-display-md">{% if collection.title != blank %}{{ collection.title }}{% else %}Shop{% endif %}.</h1>
  <ul class="mt-10 grid gap-6 sm:grid-cols-2">
    {%- assign list = 'nuv-velvet-blanket,nuv-velvet-blanket-custom' | split: ',' -%}
    {%- for h in list -%}
      {%- assign p = all_products[h] -%}
      {%- if p.id -%}
      <li>
        <a href="{{ p.url }}" class="group block">
          <div class="relative aspect-[4/5] overflow-hidden rounded-soft bg-oat-soft"><img src="{{ p.featured_image | image_url: width: 1000 }}" alt="{{ p.featured_image.alt | split: '| ' | last | escape }}" class="absolute inset-0 h-full w-full object-cover" loading="lazy"></div>
          <p class="mt-3 font-serif text-[1.4rem] font-light tracking-[-0.02em] group-hover:text-mocha">{{ p.title }}</p>
          <p class="text-[0.95rem] text-charcoal/70">From {{ p.price_min | money }}</p>
        </a>
      </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
