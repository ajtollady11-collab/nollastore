<section class="container-soft flex min-h-dvh flex-col items-center justify-center py-16 text-center">
  <span class="font-serif font-normal lowercase tracking-[-0.045em] text-[3rem]" style="font-variation-settings:'SOFT' 100, 'opsz' 72">nolla</span>
  <p class="mt-4 max-w-[34ch] text-lg leading-relaxed text-charcoal/75">make staying in feel better. We’re opening soon.</p>
  <div class="mt-10 w-full max-w-sm">
    {%- form 'storefront_password', class: 'space-y-3' -%}
      {%- if form.errors -%}<p role="alert" class="text-[0.9rem] text-mocha">That password isn’t right.</p>{%- endif -%}
      <label class="sr-only" for="Password">Password</label>
      <input class="nolla-input" type="password" name="password" id="Password" placeholder="Password" autocomplete="current-password">
      <button type="submit" class="relative inline-flex select-none items-center justify-center gap-2 whitespace-nowrap rounded-full font-sans font-medium tracking-[0.01em] transition-[background-color,color,border-color,text-decoration-color,transform] duration-300 ease-soft active:scale-[0.985] bg-charcoal text-ivory hover:bg-espresso h-14 px-8 text-[0.98rem] w-full">Enter</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Password page", "settings": [] }
{% endschema %}
