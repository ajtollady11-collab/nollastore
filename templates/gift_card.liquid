{% layout none %}
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Your nolla gift card</title>{{ content_for_header }}</head>
<body style="font-family:sans-serif;background:#F7F3EC;color:#252321;text-align:center;padding:4rem 1rem">
