{%- comment -%} The bag. Filled in by nolla.js from /cart.js; markup and classes as on the original site. {%- endcomment -%}
<div data-cart-drawer class="fixed inset-0 z-[60] pointer-events-none" inert aria-hidden="true">
  <div data-cart-overlay class="absolute inset-0 bg-charcoal/30 transition-opacity duration-500 ease-soft opacity-0"></div>
  <div data-cart-panel role="dialog" aria-modal="true" aria-labelledby="bag-title" class="absolute inset-y-0 right-0 flex w-full max-w-[440px] flex-col bg-cream shadow-cloud transition-transform duration-[600ms] ease-soft translate-x-full">
    <div class="flex h-16 shrink-0 items-center justify-between border-b border-charcoal/10 px-5 sm:px-7">
      <h2 id="bag-title" class="font-serif text-[1.5rem] font-light tracking-[-0.02em]">Your bag<span data-cart-title-count></span></h2>
      <button data-cart-close type="button" aria-label="Close bag" class="-mr-2.5 grid h-11 w-11 place-items-center rounded-full hover:bg-charcoal/[0.05]">
        <svg aria-hidden="true" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
    <div data-cart-body class="flex min-h-0 flex-1 flex-col"></div>
  </div>
</div>
